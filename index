<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Reward USD</title>

<link rel="stylesheet" href="style.css">

<script src="https://telegram.org/js/telegram-web-app.js"></script>

</head>


<body>


<div class="container">


<h1>💵 Reward USD</h1>

<p class="subtitle">
Earn rewards by completing tasks
</p>



<div class="balance-box">

<p>Your Balance</p>

<h2 id="balance">
$0.00
</h2>

</div>



<div class="card">

<h3>🎁 Daily Bonus</h3>

<p>
Claim your daily reward
</p>


<button onclick="dailyBonus()">
Claim +$0.05
</button>


</div>




<div class="card">


<h3>💰 Earn Money</h3>


<div class="task">

<h4>🔥 Task 1</h4>

<p>
Visit Offer
<br>
Reward: +$0.01
</p>

<button onclick="completeTask(0)">
START
</button>

</div>




<div class="task">

<h4>🔥 Task 2</h4>

<p>
Special Offer
<br>
Reward: +$0.02
</p>

<button onclick="completeTask(1)">
START
</button>

</div>





<div class="task">

<h4>🔥 Task 3</h4>

<p>
Premium Offer
<br>
Reward: +$0.03
</p>

<button onclick="completeTask(2)">
START
</button>

</div>


</div>





<div class="card withdraw">

<h3>💸 Withdraw</h3>

<p>
Minimum withdrawal: $5.00
</p>


<button disabled>
Request Withdrawal
</button>


</div>



</div>


<script src="app.js"></script>


</body>
</html>
